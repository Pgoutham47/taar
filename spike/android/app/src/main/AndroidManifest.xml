<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO is the only permission requested. There is deliberately no
      INTERNET permission: the app has no server, no account and nothing to upload,
      and its absence from this file is a claim a judge can check in thirty seconds.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.sensor.compass" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Taar"
        android:supportsRtl="true"
        android:theme="@style/Theme.Taar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:label="Taar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
